{
  "name": "@osva/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./builder": {
      "types": "./dist/builder/index.d.ts",
      "import": "./dist/builder/index.js"
    },
    "./builder/parse": {
      "types": "./dist/builder/builder-proposal-schema.d.ts",
      "import": "./dist/builder/builder-proposal-schema.js"
    },
    "./builder/changes": {
      "types": "./dist/builder/compare-builder-proposal-changes.d.ts",
      "import": "./dist/builder/compare-builder-proposal-changes.js"
    },
    "./workflow-definition": {
      "types": "./dist/workflow-definition.d.ts",
      "import": "./dist/workflow-definition.js"
    },
    "./office-execution-context": {
      "types": "./dist/office-execution-context-projection.d.ts",
      "import": "./dist/office-execution-context-projection.js"
    },
    "./office-deliverable-provenance": {
      "types": "./dist/office-deliverable-provenance.d.ts",
      "import": "./dist/office-deliverable-provenance.js"
    },
    "./office-activity": {
      "types": "./dist/office-activity-projection.d.ts",
      "import": "./dist/office-activity-projection.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@osva-ai/contracts": "workspace:*",
    "cron-parser": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
