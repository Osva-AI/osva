{
  "name": "@osva/cli",
  "version": "1.0.0",
  "description": "Official OSVA command-line interface",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Osva-AI/osva.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Osva-AI/osva/tree/main/packages/cli",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "osva": "./dist/bin/osva.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@osva/contracts": "workspace:*",
    "@osva/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
