{
  "name": "@osva/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "migrate": "node dist/migrate-cli.js",
    "bootstrap": "node dist/bootstrap-cli.js",
    "migrations:verify": "node dist/migrations-verify-cli.js",
    "migrations:lock": "node dist/migrations-lock-cli.js",
    "migrations:status": "node dist/migrations-status-cli.js"
  },
  "dependencies": {
    "@osva/contracts": "workspace:*",
    "@osva/domain": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "0.31.10",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
