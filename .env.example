# Local development examples only. Not production-safe.
# Processes read these from the environment; they do not auto-load .env.

# ── Core (required for local Community Beta) ────────────────────────────────
OSVA_DATABASE_URL=postgres://osva:osva@127.0.0.1:5432/osva
OSVA_VALKEY_URL=redis://127.0.0.1:6379
OSVA_TRUSTED_RUNTIME_ROOT=./trusted-runtime
OSVA_WEB_HOST=127.0.0.1
OSVA_WEB_PORT=3000

# Artifact storage (filesystem or S3-compatible)
OSVA_ARTIFACT_STORAGE_DRIVER=filesystem
OSVA_ARTIFACT_FILESYSTEM_ROOT=.osva/artifacts
OSVA_ARTIFACT_MAX_BYTES=67108864
# OSVA_ARTIFACT_STORAGE_DRIVER=s3
# OSVA_ARTIFACT_S3_BUCKET=
# OSVA_ARTIFACT_S3_REGION=us-east-1
# OSVA_ARTIFACT_S3_ENDPOINT=
# OSVA_ARTIFACT_S3_ACCESS_KEY_ID=
# OSVA_ARTIFACT_S3_SECRET_ACCESS_KEY=
# OSVA_ARTIFACT_S3_FORCE_PATH_STYLE=true

# ── Model providers (optional; worker-only) ─────────────────────────────────
# Credentials are never persisted and never copied into trusted agent child processes.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GEMINI_API_KEY=

# ── Remote HTTP runtime (optional; worker-only) ─────────────────────────────
# Required for Remote HTTP capability bridge authentication.
# OSVA_RUNTIME_CAPABILITY_SECRET=

# Operator opt-in for REMOTE_HTTP private/loopback destinations.
# Default is public destinations only. AgentVersion cannot enable this.
# OSVA_REMOTE_HTTP_ALLOW_PRIVATE_NETWORKS=true

# ── MCP / connector secrets (optional) ──────────────────────────────────────
# ConnectorVersion records store SecretReference values, not plaintext secrets.
# Resolve environment-backed references from the worker/control-plane process
# environment at runtime (exact variable names depend on connector auth config).

# ── MCP server (optional; separate process) ─────────────────────────────────
# OSVA_MCP_HOST=127.0.0.1
# OSVA_MCP_PORT=3100
# OSVA_MCP_PATH=/mcp
# OSVA_API_BASE_URL=http://127.0.0.1:3000
# Comma-separated production hostnames (no wildcards). Localhost is always allowed.
# OSVA_MCP_ALLOWED_HOSTS=mcp.example.com
# OSVA_MCP_STDIO_CONNECTORS_ENABLED=false
# OSVA_MCP_CONNECTOR_ALLOW_PRIVATE_NETWORKS=false

# ── Scheduler / workflow orchestrator (optional) ─────────────────────────────
# OSVA_SCHEDULER_POLL_MS=5000
# OSVA_WORKFLOW_ORCHESTRATOR_POLL_MS=5000

# ── Knowledge embeddings (web / worker / knowledge-worker) ───────────────────
# OSVA_KNOWLEDGE_EMBEDDING_PROVIDER=DETERMINISTIC
# OSVA_KNOWLEDGE_EMBEDDING_MODEL=deterministic-v1
# OSVA_KNOWLEDGE_EMBEDDING_DIMENSIONS=384
# OSVA_KNOWLEDGE_EMBEDDING_API_KEY=
# OSVA_KNOWLEDGE_EMBEDDING_BASE_URL=

# ── Container runtime (worker; off by default in Kubernetes) ─────────────────
# OSVA_CONTAINER_ENABLED=false

# ── OpenTelemetry (optional) ────────────────────────────────────────────────
# When unset, OSVA runs normally with no OTLP export.
# RunStep remains the durable product observability authority.
# OTEL_SERVICE_NAME=osva
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer replace-me
# OTEL_SDK_DISABLED=true
