# Local development examples only. Not production-safe.
# Processes read these from the environment; they do not auto-load .env.

OSVA_DATABASE_URL=postgres://osva:osva@127.0.0.1:5432/osva
OSVA_VALKEY_URL=redis://127.0.0.1:6379
OSVA_TRUSTED_RUNTIME_ROOT=./trusted-runtime
OSVA_WEB_HOST=127.0.0.1
OSVA_WEB_PORT=3000

# Optional. Worker-only OpenAI credential for ModelGateway. Never persisted
# and never copied into trusted agent child processes.
# OPENAI_API_KEY=

# Optional. Worker-only. Required for Remote HTTP capability bridge.
# OSVA_RUNTIME_CAPABILITY_SECRET=

# Optional. Worker-only operator opt-in for REMOTE_HTTP private/loopback
# destinations. Default is public destinations only. AgentVersion cannot
# enable this.
# OSVA_REMOTE_HTTP_ALLOW_PRIVATE_NETWORKS=true
