{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://osva.ai/examples/canonical-dependency-adoption/research-output.v1.schema.json",
  "title": "Canonical dependency adoption research output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "request", "research"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "packageName", "useCase", "constraints"],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "packageName": {
          "type": "string",
          "minLength": 1
        },
        "useCase": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageName",
        "policyEvidence",
        "externalEvidence",
        "findings",
        "warnings"
      ],
      "properties": {
        "packageName": {
          "type": "string",
          "minLength": 1
        },
        "policyEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "knowledgeChunkId",
              "knowledgeSourceId",
              "score",
              "excerpt"
            ],
            "properties": {
              "knowledgeChunkId": {
                "type": "string",
                "minLength": 1
              },
              "knowledgeSourceId": {
                "type": "string",
                "minLength": 1
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "heading": {
                "type": "string",
                "minLength": 1
              },
              "excerpt": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "externalEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["npmPackage", "npmDownloads"],
          "properties": {
            "npmPackage": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "latestVersion", "maintainersCount"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "latestVersion": {
                  "type": "string",
                  "minLength": 1
                },
                "license": {
                  "type": "string",
                  "minLength": 1
                },
                "repositoryUrl": {
                  "type": "string",
                  "minLength": 1
                },
                "modifiedAt": {
                  "type": "string",
                  "minLength": 1
                },
                "deprecated": {
                  "type": "string",
                  "minLength": 1
                },
                "maintainersCount": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "npmDownloads": {
              "type": "object",
              "additionalProperties": false,
              "required": ["period", "downloads", "start", "end"],
              "properties": {
                "period": {
                  "type": "string",
                  "minLength": 1
                },
                "downloads": {
                  "type": "integer",
                  "minimum": 0
                },
                "start": {
                  "type": "string",
                  "minLength": 1
                },
                "end": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
