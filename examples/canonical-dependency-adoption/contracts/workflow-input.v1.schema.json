{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://osva.ai/examples/canonical-dependency-adoption/workflow-input.v1.schema.json",
  "title": "Canonical dependency adoption workflow input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "request"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "packageName", "useCase", "constraints"],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "packageName": {
          "type": "string",
          "minLength": 1
        },
        "useCase": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
