{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://osva.ai/examples/canonical-dependency-adoption/report-output.v1.schema.json",
  "title": "Canonical dependency adoption report output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "disposition",
    "summary",
    "artifact"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "disposition": {
      "type": "string",
      "enum": ["ADOPT", "PILOT", "DO_NOT_ADOPT", "NEEDS_REVIEW"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "artifactId"],
      "properties": {
        "type": {
          "type": "string",
          "const": "artifact"
        },
        "artifactId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
