{
  "uid": "osva-queue-worker",
  "title": "OSVA queue and worker",
  "tags": ["osva", "example"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Queue jobs by state",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "osva_queue_jobs{queue=\"execution\"}",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Queue-to-start delay p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(osva_queue_time_to_start_ms_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Stalled jobs",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(osva_queue_stalled_total[5m]))",
          "legendFormat": "stalled"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Transport reconciliation",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(osva_recovery_transport_repaired_total[5m]))",
          "legendFormat": "newly enqueued repairs"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Interruption and recovery errors",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(osva_recovery_lease_interrupted_total[5m]))",
          "legendFormat": "lease interrupted"
        },
        {
          "refId": "B",
          "expr": "sum(rate(osva_recovery_errors_total[5m]))",
          "legendFormat": "recovery errors"
        }
      ]
    }
  ]
}
