{
  "uid": "osva-agent-execution",
  "title": "OSVA agent execution",
  "tags": ["osva", "example"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Run starts",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(osva_runs_started_total[5m]))",
          "legendFormat": "started"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Successful / failed runs",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(osva_runs_completed_total[5m]))",
          "legendFormat": "completed"
        },
        {
          "refId": "B",
          "expr": "sum(rate(osva_runs_failed_total[5m]))",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Recovery interruptions",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(osva_recovery_lease_interrupted_total[5m]))",
          "legendFormat": "lease interrupted"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Attempt duration p95",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, terminal_status) (rate(osva_run_attempt_duration_ms_bucket[5m])))",
          "legendFormat": "p95 {{terminal_status}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Runtime duration p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, runtime_kind) (rate(osva_runtime_execute_duration_ms_bucket[5m])))",
          "legendFormat": "p95 {{runtime_kind}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Model and tool failures",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(osva_tool_errors_total[5m]))",
          "legendFormat": "tool errors"
        },
        {
          "refId": "B",
          "expr": "sum(rate(osva_model_calls_total[5m]))",
          "legendFormat": "model calls"
        }
      ]
    }
  ]
}
