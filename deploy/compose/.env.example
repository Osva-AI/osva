# Self-hosted OSVA Compose distribution (deploy/compose).
# Copy to .env and set operator-provided values before `docker compose up`.

# Required: choose a strong password for bundled PostgreSQL.
POSTGRES_PASSWORD=change-me

# Optional published ports (host side).
OSVA_PUBLISH_WEB_PORT=8080
OSVA_PUBLISH_MCP_PORT=3100

# Optional image override after building locally.
# OSVA_IMAGE=osva:local

# Knowledge embeddings (Community smoke defaults; use a real provider in production).
OSVA_KNOWLEDGE_EMBEDDING_PROVIDER=DETERMINISTIC
OSVA_KNOWLEDGE_EMBEDDING_MODEL=deterministic-v1
OSVA_KNOWLEDGE_EMBEDDING_DIMENSIONS=384

# When exposing MCP behind a public hostname, list allowed Host header values (comma-separated).
# OSVA_MCP_ALLOWED_HOSTS=mcp.example.com

# Bootstrap (explicit one-time command only):
# docker compose --profile bootstrap run --rm bootstrap
# OSVA_BOOTSTRAP_WORKSPACE_NAME=Default Workspace
