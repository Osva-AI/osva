# Self-hosted OSVA Compose distribution (deploy/compose).
# Copy to .env and set operator-provided values before `docker compose up`.

# Required: choose a strong password for bundled PostgreSQL.
POSTGRES_PASSWORD=change-me

# In-container Valkey URL (Compose interpolation).
# Host shell exports override BOTH this file and `docker compose --env-file`:
# an env-file line alone does not stop leakage from contributor `export` sessions.
# Unset host OSVA_VALKEY_URL before `docker compose up`, or keep the value below.
OSVA_VALKEY_URL=redis://valkey:6379

# Optional Valkey AUTH for production Compose. Leave empty to keep the
# no-auth topology (default). When set, also set OSVA_VALKEY_URL with the
# password; do not log that URL.
# VALKEY_PASSWORD=
# OSVA_VALKEY_URL=redis://:change-me@valkey:6379

# Optional published ports (host side).
OSVA_PUBLISH_WEB_PORT=8080
OSVA_PUBLISH_MCP_PORT=3100

# Optional image override (pre-built registry image after RC2 publish):
# OSVA_IMAGE=ghcr.io/osva-ai/osva:1.1.0-rc.2
# Local Dockerfile build (default when unset):
# OSVA_IMAGE=osva:local

# Human authentication (required for the web service; use a long random secret in production).
OSVA_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# OSVA_AUTH_BASE_URL=http://127.0.0.1:8080
# OSVA_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:8080

# Knowledge embeddings (Community smoke defaults; use a real provider in production).
OSVA_KNOWLEDGE_EMBEDDING_PROVIDER=DETERMINISTIC
OSVA_KNOWLEDGE_EMBEDDING_MODEL=deterministic-v1
OSVA_KNOWLEDGE_EMBEDDING_DIMENSIONS=384

# When exposing MCP behind a public hostname, list allowed Host header values (comma-separated).
# OSVA_MCP_ALLOWED_HOSTS=mcp.example.com

# Bootstrap (explicit one-time command only):
# docker compose --profile bootstrap run --rm bootstrap
# OSVA_BOOTSTRAP_WORKSPACE_NAME=Default Workspace

# Observability overlay (optional; not enabled by default):
# docker compose -f compose.yml -f compose.observability.yml up -d
# OTEL_TRACES_SAMPLER=parentbased_always_on
# OSVA_PUBLISH_GRAFANA_PORT=3001
# GRAFANA_ADMIN_PASSWORD=osva-example
# OSVA_METRICS_RETENTION=15d
# OTEL_EXPORTER_OTLP_HEADERS belongs in a secret, not this file.
