{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["database", "valkey"],
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string" }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "url": { "type": "string" }
      }
    },
    "valkey": {
      "type": "object",
      "properties": {
        "url": { "type": "string" }
      }
    },
    "existingSecret": { "type": "string" },
    "secretEnv": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "health": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "containerEnabled": { "type": "boolean" }
      }
    },
    "migration": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "serviceAccountName": { "type": "string" }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "otlpEndpoint": { "type": "string" },
        "serviceNameOverride": { "type": "string" },
        "tracesSampler": {
          "type": "string",
          "enum": [
            "always_on",
            "always_off",
            "traceidratio",
            "parentbased_always_on",
            "parentbased_always_off",
            "parentbased_traceidratio",
            ""
          ]
        },
        "tracesSamplerArg": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "telemetry": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          }
        },
        "required": ["telemetry"]
      },
      "then": {
        "properties": {
          "telemetry": {
            "properties": {
              "otlpEndpoint": { "type": "string", "minLength": 1 }
            },
            "required": ["otlpEndpoint"]
          }
        }
      }
    }
  ]
}
