{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "test/**/*.ts",
    "test/**/*.tsx",
    "test/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
