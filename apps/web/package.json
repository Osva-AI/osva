{
  "name": "@osva/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch dist/main.js",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@osva/adapters-artifact-storage": "workspace:*",
    "@osva/adapters-bullmq": "workspace:*",
    "@osva/adapters-embedding-openai-compatible": "workspace:*",
    "@osva/adapters-vector-pgvector": "workspace:*",
    "@osva/embedding-gateway": "workspace:*",
    "@osva/adapters-opentelemetry": "workspace:*",
    "@osva/adapters-mcp-client": "workspace:*",
    "@osva/adapters-runtime-http": "workspace:*",
    "@osva/contracts": "workspace:*",
    "@osva/db": "workspace:*",
    "@osva/domain": "workspace:*",
    "@osva/orchestration": "workspace:*",
    "@osva/observability": "workspace:*",
    "busboy": "1.6.0"
  },
  "devDependencies": {
    "@osva/adapters-mcp-client": "workspace:*",
    "@osva/adapters-memory": "workspace:*",
    "@osva/adapters-artifact-storage": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/busboy": "1.5.4"
  }
}
