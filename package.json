{
  "name": "osva",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build --concurrency=2",
    "lint": "turbo run lint --concurrency=2",
    "typecheck": "turbo run typecheck --concurrency=2",
    "test": "turbo run test --concurrency=2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "turbo run test:integration --concurrency=1",
    "verify:doctor": "node scripts/verification/verify.mjs doctor",
    "verify:quick": "node scripts/verification/verify.mjs quick",
    "verify:changed": "node scripts/verification/verify.mjs changed",
    "verify:branch": "node scripts/verification/branch-verify.mjs",
    "verify:docker": "node scripts/verification/verify.mjs docker",
    "verify:ci": "node scripts/verification/verify.mjs ci",
    "verify:python": "node scripts/verification/verify.mjs python",
    "verify:ci:clean": "node scripts/verification/verify.mjs ci:clean",
    "verify:community-beta": "node scripts/verification/verify.mjs ci:clean",
    "infra:up": "node scripts/verification/verify.mjs docker && docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:migrate": "turbo run build --filter=@osva/db && pnpm --filter @osva/db migrate",
    "db:bootstrap": "turbo run build --filter=@osva/db && pnpm --filter @osva/db bootstrap",
    "identity:bootstrap": "turbo run build --filter=@osva/identity && pnpm --filter @osva/identity bootstrap",
    "identity:recover": "turbo run build --filter=@osva/identity && pnpm --filter @osva/identity recover",
    "db:identity-bootstrap": "pnpm identity:bootstrap",
    "db:identity-recover": "pnpm identity:recover",
    "db:migrations:verify": "turbo run build --filter=@osva/db && pnpm --filter @osva/db migrations:verify",
    "db:migrations:lock": "turbo run build --filter=@osva/db && pnpm --filter @osva/db migrations:lock",
    "db:migrations:status": "turbo run build --filter=@osva/db && pnpm --filter @osva/db migrations:status",
    "db:migrations:integrity": "turbo run build --filter=@osva/db && pnpm --filter @osva/db migrations:integrity",
    "release:version:check": "node scripts/release/version-consistency.mjs",
    "release:licenses": "node scripts/release/generate-license-inventory.mjs",
    "release:acceptance": "node scripts/release/release-acceptance.mjs",
    "release:npm:artifacts": "node scripts/release/npm-pack-artifacts.mjs",
    "release:npm:test": "node --test scripts/release/test/*.test.mjs",
    "dev:web": "pnpm --filter @osva/web dev",
    "dev:console": "pnpm --filter @osva/console dev",
    "dev:worker": "pnpm --filter @osva/worker dev",
    "dev:scheduler": "pnpm --filter @osva/scheduler dev",
    "dev:workflow-orchestrator": "pnpm --filter @osva/workflow-orchestrator dev",
    "dev:knowledge-worker": "pnpm --filter @osva/knowledge-worker dev",
    "dev:mcp-server": "pnpm --filter @osva/mcp-server dev",
    "canonical:setup": "pnpm --filter @osva/example-canonical-dependency-adoption run setup",
    "canonical:run": "pnpm --filter @osva/example-canonical-dependency-adoption run run",
    "canonical:status": "pnpm --filter @osva/example-canonical-dependency-adoption run status",
    "canonical:approve": "pnpm --filter @osva/example-canonical-dependency-adoption run approve",
    "canonical:emit-delivery-event": "pnpm --filter @osva/example-canonical-dependency-adoption run emit-delivery-event",
    "canonical:demo": "pnpm --filter @osva/example-canonical-dependency-adoption run demo",
    "example:hello": "pnpm --filter @osva/example-hello-agent... build && pnpm --filter @osva/example-hello-agent run hello",
    "example:hello:build": "pnpm --filter @osva/example-hello-agent run build",
    "example:hello:test": "pnpm --filter @osva/example-hello-agent test",
    "example:hello:test:integration": "pnpm --filter @osva/example-hello-agent test:integration",
    "acceptance:m10-1a": "node scripts/acceptance/m10-1a/run.mjs",
    "acceptance:m10-1a:test": "node --test scripts/acceptance/m10-1a/test/*.test.mjs",
    "acceptance:m10-2e": "node scripts/acceptance/m10-2e/run.mjs",
    "acceptance:m10-2e:pack": "node scripts/acceptance/m10-2e/pack-acceptance.mjs",
    "acceptance:m10-2e:test": "node --test scripts/acceptance/m10-2e/test/*.test.mjs",
    "canonical:test:integration": "pnpm --filter @osva/example-canonical-dependency-adoption run test:integration",
    "acceptance:m9-7b": "node scripts/acceptance/m9-7b/run.mjs",
    "acceptance:m9-7b:test": "node --test scripts/acceptance/m9-7b/test/*.test.mjs",
    "acceptance:m12-3": "node scripts/acceptance/m12-3/run.mjs",
    "acceptance:m12-3:browser": "node scripts/acceptance/m12-3/run.mjs --with-browser",
    "acceptance:m12-3:browser-ci": "node scripts/acceptance/m12-3/run.mjs --browser-only",
    "acceptance:m12-3:test": "node --test scripts/acceptance/m12-3/test/*.test.mjs",
    "acceptance:m15": "node scripts/acceptance/m15-4/run.mjs",
    "acceptance:m15:integration": "node scripts/acceptance/m15-4/run.mjs --profile=integration",
    "acceptance:m15:browser": "node scripts/acceptance/m15-4/run.mjs --profile=browser",
    "acceptance:m15:full": "node scripts/acceptance/m15-4/run.mjs --profile=full",
    "acceptance:m15:test": "node --test scripts/acceptance/m15-4/test/*.test.mjs",
    "acceptance:r11-registry": "node scripts/acceptance/r11-registry-only/run.mjs",
    "acceptance:r11-registry:test": "node --test scripts/acceptance/r11-registry-only/test/*.test.mjs",
    "acceptance:m16-2d": "node scripts/acceptance/m16-2d/run.mjs",
    "acceptance:m16-2d:test": "node --test scripts/acceptance/m16-2d/test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "playwright": "^1.55.0",
    "vitest": "catalog:"
  }
}
