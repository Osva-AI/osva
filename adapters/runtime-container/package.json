{
  "name": "@osva/adapters-runtime-container",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.json && vitest run --config vitest.config.ts",
    "test:integration": "tsc -p tsconfig.json && vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@osva/adapters-runtime-http": "workspace:*",
    "@osva/contracts": "workspace:*",
    "@osva/runtime-core": "workspace:*",
    "@osva/runtime-protocol": "workspace:*",
    "dockerode": "^4.0.9"
  },
  "devDependencies": {
    "@osva/adapters-memory": "workspace:*",
    "@osva/domain": "workspace:*",
    "@osva/observability": "workspace:*",
    "@types/dockerode": "^3.3.47",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
